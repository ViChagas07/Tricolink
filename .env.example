# ===== API (apps/api) — lido SOMENTE em core/config.py via os.getenv() =====
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_USER=tricolink
POSTGRES_PASSWORD=tricolink
POSTGRES_DB=tricolink
# Role de runtime não-superuser (RLS aplica). O Compose define DATABASE_URL com ela.
POSTGRES_APP_USER=tricolink_app
POSTGRES_APP_PASSWORD=tricolink_app
# Em produção, use um role de migração separado e privilegiado.
MIGRATION_DATABASE_URL=postgresql+asyncpg://tricolink:tricolink@postgres:5432/tricolink
DATABASE_URL=postgresql+asyncpg://tricolink_app:tricolink_app@postgres:5432/tricolink
REDIS_URL=redis://redis:6379/0

# Portas publicadas no host (dev)
API_PORT=8000
WEB_PORT=3000

# URLs
FRONTEND_ORIGIN=http://localhost:3000
SHORT_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:8000

# Auth
JWT_SECRET=change-me-min-32-bytes-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
CSRF_SECRET=change-me-min-32-bytes-random
SESSION_SECRET=change-me-min-32-bytes-random
# Argon2id (OWASP)
ARGON2_TIME_COST=2
ARGON2_MEMORY_KIB=19456
ARGON2_PARALLELISM=1
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16
# Anti brute force
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_SECONDS=900
OAUTH_SESSION_TTL_SECONDS=600
COOKIE_SECURE=false
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Proxy / IP real
TRUSTED_PROXY_COUNT=1

# Cache (SWR + jitter + single-flight)
CACHE_HARD_TTL_SECONDS=86400
CACHE_SOFT_TTL_SECONDS=600
CACHE_JITTER_PCT=0.15
NEGATIVE_CACHE_TTL_SECONDS=30
STATS_CACHE_TTL_SECONDS=30
LOCK_TTL_MS=5000
CACHE_WAIT_TIMEOUT_SECONDS=0.25

# DNS (UrlPolicy) e cliques
DNS_TIMEOUT_SECONDS=2
CLICK_STREAM_KEY=tl:clicks
CLICK_STREAM_GROUP=tricolink-flusher
CLICK_STREAM_MAXLEN=100000
CLICK_FLUSH_BATCH_SIZE=500
CLICK_FLUSH_BLOCK_MS=1000
CLICK_PUBLISH_TIMEOUT_SECONDS=0.2
CLICK_FLUSHER_ENABLED=true

# Quotas e Token Bucket
ANON_DAILY_LINK_LIMIT=5
USER_DAILY_LINK_LIMIT=100
ANON_LINK_TTL_DAYS=30
RL_REDIRECT_CAPACITY=120
RL_REDIRECT_REFILL_PER_SEC=20
RL_CREATE_CAPACITY=10
RL_CREATE_REFILL_PER_SEC=0.2
RL_AUTH_CAPACITY=5
RL_AUTH_REFILL_PER_SEC=0.02
RL_GLOBAL_CAPACITY=2000
RL_GLOBAL_REFILL_PER_SEC=1000
RL_LIST_CAPACITY=60
RL_LIST_REFILL_PER_SEC=1
MAX_BODY_BYTES=16384
REQUEST_TIMEOUT_SECONDS=10

# Banco (pool e timeouts)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=10

# Redis (pool e timeouts)
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2

# Resiliência
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=15
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1
BULKHEAD_DB_READ=20
BULKHEAD_DB_WRITE=10
BULKHEAD_HASHING=4
BULKHEAD_DNS=10
BULKHEAD_ACQUIRE_TIMEOUT_SECONDS=1

# Observabilidade (opcional)
SENTRY_DSN=
METRICS_TOKEN=change-me

# ===== WEB (apps/web) =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHORT_BASE_URL=http://localhost:3000
# Server-only (NUNCA prefixar com NEXT_PUBLIC_)
API_INTERNAL_URL=http://api:8000

# Retenção do job de limpeza (dias) e lote
CLICK_RETENTION_DAYS=365
CLEANUP_BATCH_SIZE=5000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
