{
  "name": "tricolink-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "i18n:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scan:bundle": "node scripts/scan-bundle.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
